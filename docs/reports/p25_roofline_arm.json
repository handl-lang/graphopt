    {
      "variant": "magic_fold",
      "why": "cosine 0.99936/0.99918 < 0.9999 \u2014 fp16 product rounding lands on the 1024-weighted term that is then differenced; the single-rounding FMA keeps the offset exact but explicit tl.fma is slower than letting ptxas contract (m-1024)*x"
    },
    {
      "variant": "dot (tl.dot tensor cores)",
      "why": "60-66 us \u2014 broadcast/layout cost exceeds the tensor-core gain at [16,BK]x[BK,BN]"
    },
    {
      "variant": "pair (inline-asm mov.b32 -> 2xfp16)",
      "why": "42 us \u2014 the register interleave costs more than the halved unpack saves"
    },
    {
      "variant": "magic_h16 (fp16 tl.sum)",
      "why": "slower (32-36 us) and cosine drops to 0.999999"
    },
    {
      "variant": "i2f (plain int->fp16)",
      "why": "competitive on gate (29.4 us) but loses to magic on down (32.9 vs 30.8)"
    },
    {
      "variant": "magic_hint (max_contiguous)",
      "why": "neutral \u2014 already vectorised"
