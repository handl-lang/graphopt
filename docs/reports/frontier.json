  "findings": [
    {
      "claim": "An equality-preserving rewrite cannot change a dense model's FLOPs, so its ceiling is the dispatch share, 1/(1-F). Where F is small the ceiling is ~1x.",
      "verdict": "negative",
      "headline": "compute-bound rows are capped at 1.03x \u2014 equality-preserving rewrites cannot reach them",
      "metric": "median_ceiling_compute_bound",
      "value": 1.029
    },
    {
      "claim": "The delivered body captures the headroom the ceiling allows: (speedup-1)/(ceiling-1).",
      "verdict": "negative",
      "headline": "median capture -0.03 over 35 rows with material headroom \u2014 delivery loses more than the algebra gains; the binding constraint is the delivered body, not the ceiling",
      "metric": "median_captured_fraction",
      "value": -0.03198193926750457
    },
    {
      "claim": "Dispatch share predicts the sign of the win. (It does not always \u2014 the delivered body's own cost sets it.)",
      "verdict": "inconclusive",
      "headline": "r(F, speedup) = +0.08 \u2014 dispatch share does not predict the sign alone",
      "metric": "pearson_dispatch_vs_speedup",
      "value": 0.07976050064043434
    },
    {
      "claim": "The wins survive `torch.compile` \u2014 the free competitor every PyTorch user already has \u2014 not just eager.",
      "verdict": "win",
      "headline": "13/25 launch-bound rows beat torch.compile (median 1.11x); compute-bound 13/28 at 0.99x",
      "metric": "beat_compile_fraction_launch_bound",
      "value": 0.52
    },
    {
      "claim": "Every delivered row is verified equal to the spelled module \u2014 the frontier is measured on correct deliveries.",
      "verdict": "win",
      "headline": "65/65 rows verified equal",
      "metric": "verified_fraction",
      "value": 1.0
    }
